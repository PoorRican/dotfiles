#!/usr/bin/env python3
"""Report Drift's live tray state to Waybar without changing recording."""
import json
import subprocess

ICON = ""
HINT = "Left-click: start/pause recording\nRight-click: record a note"
STATUS_ERRORS = (OSError, ValueError, KeyError, TypeError, IndexError, subprocess.SubprocessError)
SNI = "org.kde.StatusNotifierItem"


def busctl(*args):
    result = subprocess.run(
        ["/usr/bin/busctl", "--user", "--timeout=1", "--json=short", "--", *args],
        capture_output=True, text=True, check=True, timeout=2,
    )
    return json.loads(result.stdout)["data"]


def layout_state(layout):
    """Read the disabled status row, not the toggle action or a cached flag."""
    states = set()
    pending = [layout]
    while pending:
        node = pending.pop()
        if isinstance(node, dict):
            node = node["data"]
        _, properties, children = node
        label = properties.get("label", {}).get("data")
        if label == "● Recording":
            states.add(True)
        elif label == "❚❚ Paused":
            states.add(False)
        pending.extend(children)
    return states.pop() if len(states) == 1 else None


def recording_state(query):
    items = query("get-property", "org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
                  "org.kde.StatusNotifierWatcher", "RegisteredStatusNotifierItems")
    for item in items:
        service, separator, path = item.partition("/")
        path = "/" + path if separator else "/StatusNotifierItem"
        try:
            if query("get-property", service, path, SNI, "Title") != "drift":
                continue
            menu = query("get-property", service, path, SNI, "Menu")
            _, layout = query("call", service, menu, "com.canonical.dbusmenu", "GetLayout",
                              "iias", "0", "-1", "1", "label")
            return layout_state(layout)
        except STATUS_ERRORS:
            # A tray item can vanish between the registry and property reads.
            continue
    return None


def render(query=busctl):
    try:
        recording = recording_state(query)
    except STATUS_ERRORS:
        recording = None
    state = "recording" if recording is True else "paused" if recording is False else "unavailable"
    return {"text": ICON, "class": state, "tooltip": f"Drift: {state}\n{HINT}"}


if __name__ == "__main__":
    print(json.dumps(render()))
