layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/download/v0.24.0/zjstatus.wasm" {
                // Keep this aligned with the repo's pinned zjstatus setup; see
                // pk-wiki.kdl and config.kdl for the flicker note.
                // hide_frame_for_single_pane "true"

                format_left  "{mode} {tabs}"
                format_center "#[bg=#111111,fg=#87ceeb,bold]{session}"
                format_right "@{command_hostname}{command_datetime}"
                format_space "#[bg=#111111]"
                format_hide_on_overlength "true"
                format_precedence "lcr"

                border_enabled "false"

                mode_normal        "#[bg=#111111,fg=#719611,bold] N "
                mode_locked        "#[bg=#111111,fg=#aa4450,bold] L "
                mode_resize        "#[bg=#111111,fg=#6688aa,bold] R "
                mode_pane          "#[bg=#111111,fg=#528b8b,bold] P "
                mode_tab           "#[bg=#111111,fg=#ff9800,bold] T "
                mode_scroll        "#[bg=#111111,fg=#8f6f8f,bold] S "
                mode_search        "#[bg=#111111,fg=#87ceeb,bold] / "
                mode_session       "#[bg=#111111,fg=#87875f,bold] O "
                mode_move          "#[bg=#111111,fg=#b1d631,bold] M "
                mode_enter_search  "#[bg=#111111,fg=#87ceeb,bold] / "
                mode_rename_tab    "#[bg=#111111,fg=#ff9800,bold] R "
                mode_rename_pane   "#[bg=#111111,fg=#ff9800,bold] R "
                mode_tmux          "#[bg=#111111,fg=#ff9800,bold] B "
                mode_default_to_mode "normal"

                tab_normal              "#[bg=#111111,fg=#949494] {index} {name}{fullscreen_indicator}{sync_indicator}{floating_indicator} "
                tab_normal_fullscreen   "#[bg=#111111,fg=#949494] {index} {name}{fullscreen_indicator}{sync_indicator}{floating_indicator} "
                tab_normal_sync         "#[bg=#111111,fg=#949494] {index} {name}{fullscreen_indicator}{sync_indicator}{floating_indicator} "
                tab_active              "#[bg=#111111,fg=#87ceeb,bold] {index} {name}{fullscreen_indicator}{sync_indicator}{floating_indicator} "
                tab_active_fullscreen   "#[bg=#111111,fg=#87ceeb,bold] {index} {name}{fullscreen_indicator}{sync_indicator}{floating_indicator} "
                tab_active_sync         "#[bg=#111111,fg=#87ceeb,bold] {index} {name}{fullscreen_indicator}{sync_indicator}{floating_indicator} "
                tab_separator           ""
                tab_rename              "#[bg=#111111,fg=#ff9800] {index} {name}{floating_indicator} "
                tab_fullscreen_indicator " "
                tab_sync_indicator       " "
                tab_floating_indicator   " "
                tab_display_count         "6"
                tab_truncate_start_format "#[bg=#111111,fg=#ff9800] <+{count} "
                tab_truncate_end_format   "#[bg=#111111,fg=#ff9800] +{count}> "

                // Hostname (runs once; zellij-server host)
                command_hostname_command    "sh -c 'hostname -s 2>/dev/null || uname -n'"
                command_hostname_format     "#[bg=#111111,fg=#87875f]{stdout}"
                command_hostname_interval   "0"
                command_hostname_rendermode "static"

                // Clock: host `date`, so timezone/DST always match the machine
                command_datetime_command    "date '+%H:%M %Y-%m-%d'"
                command_datetime_format     "#[bg=#111111,fg=#666666]▓░#[bg=#3a3a3a,fg=#efefef] {stdout} "
                command_datetime_interval   "1"
                command_datetime_rendermode "static"
            }
        }
    }

    tab name="hermes" focus=true {
        pane command="bash" {
            args "-lc" "hermes --tui; exec bash"
        }
    }

    tab name="shell" {
        pane command="bash" {
            args "-lc" "exec bash"
        }
    }
}
